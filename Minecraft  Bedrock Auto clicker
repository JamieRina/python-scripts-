import time
import threading
from pynput import mouse, keyboard

mouse_listener = mouse.Listener
key_controller = keyboard.Controller()

ATTACK_KEY = 'r'   # MUST match your Minecraft keybind (I changed my leftclick to R as my keybind)
CPS = 10           # Bedrock safe only registers a certain amount  of clicks
clicking = False

def clicker():
    delay = 1 / CPS
    while True:
        if clicking:
            key_controller.press(ATTACK_KEY)
            key_controller.release(ATTACK_KEY)
            time.sleep(delay)
        else:
            time.sleep(0.01)

def on_click(x, y, button, pressed):
    global clicking
    if button == mouse.Button.left:
        clicking = pressed   # True while held

threading.Thread(target=clicker, daemon=True).start()

print("BEDROCK: Hold LEFT CLICK to auto-attack")
with mouse.Listener(on_click=on_click) as listener:
    listener.join()
